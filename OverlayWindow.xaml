<Window x:Class="ClickyWindows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickyOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-9999" Top="-9999"
        Width="200" Height="200">

    <Canvas x:Name="OverlayCanvas">

        <!-- Cursor follower: blue glowing circle that trails the real mouse -->
        <Grid x:Name="CursorFollower" Width="32" Height="32"
              Canvas.Left="0" Canvas.Top="0">
            <!-- Outer glow ring -->
            <Ellipse Width="32" Height="32"
                     Stroke="#4070B8FF" StrokeThickness="2"
                     Fill="Transparent">
                <Ellipse.Effect>
                    <BlurEffect Radius="4"/>
                </Ellipse.Effect>
            </Ellipse>
            <!-- Inner solid dot -->
            <Ellipse Width="12" Height="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#CC2563EB">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#2563EB" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- Target pointer: shown when Claude returns a POINT coordinate -->
        <Grid x:Name="TargetPointer" Width="48" Height="48"
              Canvas.Left="0" Canvas.Top="0"
              Visibility="Collapsed">
            <!-- Pulsing outer ring -->
            <Ellipse x:Name="PulseRing" Width="48" Height="48"
                     Stroke="#FF2563EB" StrokeThickness="2"
                     Fill="Transparent" Opacity="0">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" CenterX="24" CenterY="24"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- Crosshair dot -->
            <Ellipse Width="16" Height="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#FF2563EB">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="1"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- Label shown near the target point -->
        <Border x:Name="TargetLabel"
                Canvas.Left="0" Canvas.Top="0"
                Visibility="Collapsed"
                Background="#CC101211"
                CornerRadius="6"
                Padding="8,4"
                BorderBrush="#44AAAAAA" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <TextBlock x:Name="TargetLabelText"
                       Foreground="#ECEEED"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       MaxWidth="300"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Listening indicator: shown while push-to-talk is active -->
        <StackPanel x:Name="ListeningIndicator"
                    Orientation="Horizontal"
                    Canvas.Left="0" Canvas.Top="0"
                    Visibility="Collapsed">
            <Border Background="#CC101211"
                    CornerRadius="20" Padding="12,6"
                    BorderBrush="#442563EB" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8"
                             Fill="#FF2563EB" Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="6" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Listening..." Foreground="#ECEEED"
                               FontSize="12" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Canvas>
</Window>
