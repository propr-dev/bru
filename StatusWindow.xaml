<Window x:Class="ClickyWindows.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="bru"
        Width="332" Height="472"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <FontFamily x:Key="Mono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

        <SolidColorBrush x:Key="Cyan"  Color="#00E5FF"/>
        <SolidColorBrush x:Key="Text"  Color="#E9EEF0"/>
        <SolidColorBrush x:Key="Body"  Color="#C4CDD2"/>
        <SolidColorBrush x:Key="Muted" Color="#7E8890"/>
        <SolidColorBrush x:Key="Faint" Color="#495159"/>
        <SolidColorBrush x:Key="Line"  Color="#1D2328"/>

        <!-- chrome buttons (collapse / hide) -->
        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#59626A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#20262C"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- primary / ghost actions -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#062028"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{StaticResource Cyan}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#5FEFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#00C2D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent"
                                BorderBrush="#2A3138" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#171C21"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- shell -->
    <Border x:Name="Shell" CornerRadius="16" Background="#0B0C0E"
            BorderBrush="#20262C" BorderThickness="1">
        <Grid>
            <!-- ═══════════ EXPANDED ═══════════ -->
            <Grid x:Name="ExpandedRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header -->
                    <RowDefinition Height="Auto"/>   <!-- hint -->
                    <RowDefinition Height="*"/>      <!-- transcript -->
                    <RowDefinition Height="Auto"/>   <!-- stop -->
                    <RowDefinition Height="Auto"/>   <!-- permission -->
                </Grid.RowDefinitions>

                <!-- header: mini living core · wordmark · state — draggable -->
                <Grid x:Name="TitleBar" Grid.Row="0" Height="56" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <!-- the living core, miniature -->
                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Ellipse Width="30" Height="30">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#4D00E5FF" Offset="0"/>
                                        <GradientStop Color="#0000E5FF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="Sonar" Width="28" Height="28" Stroke="{StaticResource Cyan}"
                                     StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="SonarScale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Arc" Width="22" Height="22" Stroke="{StaticResource Cyan}"
                                     StrokeThickness="1.6" StrokeDashArray="1 2.6" StrokeDashCap="Round"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform x:Name="ArcRotate"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Core" Width="12" Height="12" Fill="{StaticResource Cyan}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="bru" Foreground="{StaticResource Text}" FontSize="16.5"
                                   FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="14" Fill="#242B31" Margin="12,1,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateWord" Text="idle" FontFamily="{StaticResource Mono}"
                                   FontSize="11.5" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button x:Name="CollapseButton" Style="{StaticResource Chrome}" Content="&#x276F;"
                                ToolTip="Tuck bru away"/>
                        <Button x:Name="HideButton" Style="{StaticResource Chrome}" Content="&#x2715;"
                                ToolTip="Hide to tray"/>
                    </StackPanel>
                </Grid>

                <!-- hint line -->
                <TextBlock x:Name="StatusLine" Grid.Row="1" Text="hold ctrl + space and talk to me"
                           Foreground="{StaticResource Faint}" FontSize="12" Margin="20,0,20,14"
                           TextWrapping="Wrap"/>

                <!-- transcript — editorial, hairlines, no cards -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Margin="18,0,18,0" Padding="2,16,2,8">
                    <StackPanel>
                        <TextBlock Text="you" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{StaticResource Faint}"/>
                        <TextBlock x:Name="UserText" Text="nothing yet — ask me about your screen"
                                   Foreground="{StaticResource Muted}" FontSize="13" LineHeight="19"
                                   TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="76" TextTrimming="CharacterEllipsis"/>
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,15,0,15"/>
                        <TextBlock Text="bru" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{StaticResource Cyan}"/>
                        <TextBlock x:Name="BruText" Text="i can see your screen, point at things, draw on it, and teach you as you go."
                                   Foreground="{StaticResource Body}" FontSize="13" LineHeight="19"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- stop speaking -->
                <Button x:Name="StopButton" Grid.Row="3" Style="{StaticResource Ghost}"
                        HorizontalAlignment="Left" Margin="20,4,0,4" Padding="14,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#FF6E9C" VerticalAlignment="Center"/>
                        <TextBlock Text="stop speaking" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- permission -->
                <Grid Grid.Row="4" Margin="18,6,18,16">
                    <StackPanel x:Name="NoPermissionPanel" Orientation="Horizontal" Margin="2,2,0,2">
                        <Rectangle Width="12" Height="1.5" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoPermissionText" Text="no actions waiting for approval"
                                   FontFamily="{StaticResource Mono}" FontSize="10.5"
                                   Foreground="{StaticResource Faint}" Margin="9,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="PermissionCard" Background="#0D1419" CornerRadius="12"
                            BorderBrush="#1E3A42" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Cyan}" CornerRadius="12,0,0,12"/>
                            <StackPanel Grid.Column="1" Margin="15,13,15,13">
                                <TextBlock Text="permission" FontFamily="{StaticResource Mono}" FontSize="10"
                                           Foreground="{StaticResource Cyan}"/>
                                <TextBlock x:Name="PermissionText" Text="" Foreground="{StaticResource Text}"
                                           FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DenyButton" Grid.Column="0" Style="{StaticResource Ghost}" Content="deny"/>
                                    <Button x:Name="AllowButton" Grid.Column="2" Style="{StaticResource Primary}" Content="allow"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════ COLLAPSED · a small living square ═══════════ -->
            <Grid x:Name="CollapsedRoot" Visibility="Collapsed" Background="Transparent"
                  Cursor="Hand" ToolTip="bru — click to open">
                <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="34" Height="34">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5200E5FF" Offset="0"/>
                                <GradientStop Color="#0000E5FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="MiniSonar" Width="32" Height="32" Stroke="{StaticResource Cyan}"
                             StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="MiniSonarScale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="MiniCore" Width="14" Height="14" Fill="{StaticResource Cyan}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="MiniCoreScale"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
