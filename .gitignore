# ── Secrets ───────────────────────────────────────────────────────────────
# The real settings file holds live API keys. It normally lives in
# %APPDATA%\ClickyWindows\settings.json, but ignore it here too so a copy
# made in the repo folder can never be committed by accident.
settings.json
!settings.example.json
*.local.json
.env
.env.*

# ── Runtime output ────────────────────────────────────────────────────────
clicky.log
*.log

# OS
Thumbs.db
.DS_Store
desktop.ini
